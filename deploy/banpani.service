[Unit]
Description=Banpani flood relief coordination
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/banpani
EnvironmentFile=/etc/banpani.env
ExecStart=/usr/bin/node --experimental-sqlite server/server.js
Restart=always
RestartSec=3
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
